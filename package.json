{
  "name": "multiai-answer-cx",
  "version": "2.2.1",
  "description": "Multi-AI voting answer assistant for Chaoxing (学习通) - TypeScript rewrite",
  "private": true,
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for (const p of ['dist','release']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/md5": "^2.3.6",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "md5": "^2.3.0",
    "typr.js": "^1.0.0"
  }
}
